// ── Fix: Skiko WASM Runtime Resolution ──────────────────────────────────────
// The WASM binary does `import('./skiko.mjs')` at instantiation time.
// Webpack bundles skiko.mjs into composeApp.js, but the WASM binary's
// dynamic import resolves to /kotlin/skiko.mjs which returns 404.
//
// Solution: Use devServer middleware to serve skiko.mjs and skiko.wasm
// from the kotlin/ build directory so ESM imports resolve correctly.
// Also patches skiko.mjs to add the missing `skikoApi` named export.
// ──────────────────────────────────────────────────────────────────────────────

;(function(config) {
    const path = require('path');
    const fs = require('fs');

    // 1. Patch skiko.mjs to add the missing `skikoApi` export
    class SkikoApiShimPlugin {
        apply(compiler) {
            compiler.hooks.beforeCompile.tapAsync('SkikoApiShimPlugin', (params, callback) => {
                const skikoPath = path.resolve(__dirname, 'kotlin', 'skiko.mjs');
                if (!fs.existsSync(skikoPath)) {
                    callback();
                    return;
                }

                let content = fs.readFileSync(skikoPath, 'utf8');

                if (!content.includes('export const skikoApi')) {
                    const shimCode = `

// -- skikoApi shim (auto-generated by fix-skiko.js) --
export const skikoApi = {
    _callCallback,
    _createLocalCallbackScope,
    _registerCallback,
    _releaseCallback,
    _releaseLocalCallbackScope,
};
`;
                    content += shimCode;
                    fs.writeFileSync(skikoPath, content, 'utf8');
                    console.log('[SkikoApiShimPlugin] Patched skiko.mjs with skikoApi export');
                }

                callback();
            });
        }
    }

    config.plugins.push(new SkikoApiShimPlugin());

    // 2. Configure dev server to serve kotlin/ files for WASM ESM imports
    if (config.devServer) {
        const existingSetup = config.devServer.setupMiddlewares;
        config.devServer.setupMiddlewares = (middlewares, devServer) => {
            // Serve skiko.mjs from kotlin directory for WASM dynamic import resolution
            devServer.app.get('/kotlin/skiko.mjs', (req, res) => {
                const skikoPath = path.resolve(__dirname, 'kotlin', 'skiko.mjs');
                if (fs.existsSync(skikoPath)) {
                    res.setHeader('Content-Type', 'application/javascript; charset=utf-8');
                    res.setHeader('Access-Control-Allow-Origin', '*');
                    res.sendFile(skikoPath);
                } else {
                    res.status(404).send('skiko.mjs not found');
                }
            });
            
            devServer.app.get('/kotlin/skiko.wasm', (req, res) => {
                const wasmPath = path.resolve(__dirname, 'kotlin', 'skiko.wasm');
                if (fs.existsSync(wasmPath)) {
                    res.setHeader('Content-Type', 'application/wasm');
                    res.setHeader('Access-Control-Allow-Origin', '*');
                    res.sendFile(wasmPath);
                } else {
                    res.status(404).send('skiko.wasm not found');
                }
            });
            
            if (existingSetup) {
                return existingSetup(middlewares, devServer);
            }
            return middlewares;
        };
    }

})(config);
