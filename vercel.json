{
  "buildCommand": "chmod +x gradlew && ./gradlew :composeApp:wasmJsBrowserDistribution",
  "outputDirectory": "composeApp/build/distributions",
  "buildEnv": {
    "JAVA_HOME": "/opt/java/openjdk"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/callback",
      "destination": "/auth-callback.html"
    }
  ]
}