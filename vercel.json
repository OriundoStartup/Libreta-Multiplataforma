{
  "buildCommand": "chmod +x gradlew && ./gradlew :composeApp:wasmJsBrowserDistribution --no-daemon --no-configuration-cache --warning-mode none",
  "outputDirectory": "composeApp/build/dist/wasmJs/productionExecutable",
  "installCommand": "node --version && java -version",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/(.*).wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/callback",
      "destination": "/auth-callback.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}